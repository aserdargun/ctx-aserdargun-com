{
  "name": "ctx-aserdargun-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": { "node": "22.x" },
  "scripts": {
    "runtime:check": "node -p process.versions.node",
    "dev": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "build": "npm run content:check && tsc -b && vite build && tsx scripts/stamp-release.mjs",
    "content:check": "tsx scripts/validate-content.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:lifecycle": "node --test tests/lifecycle/*.test.mjs",
    "test:e2e": "playwright test",
    "preview:serve": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "preview:start": "node scripts/preview-control.mjs start",
    "preview:status": "node scripts/preview-control.mjs status",
    "preview:stop": "node scripts/preview-control.mjs stop",
    "artifact:check": "tsx scripts/validate-artifact.mjs && tsx --test tests/release/*.test.mjs",
    "check": "npm run content:check && npm run typecheck && npm run lint && npm run test:run && npm run build",
    "validate:codex": "npm run preview:stop && npm run test:lifecycle && npm run check && npm run artifact:check && npm run test:e2e && git diff --check"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.9.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.11.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^27.2.0",
    "playwright": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
}
